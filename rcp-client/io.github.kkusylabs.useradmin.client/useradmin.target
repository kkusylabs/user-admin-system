<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<?pde version="3.8"?>

<target name="UserAdmin Target" sequenceNumber="1">
  <locations>

    <location includeAllPlatforms="false"
              includeConfigurePhase="true"
              includeMode="planner"
              includeSource="true"
              type="InstallableUnit">

      <repository location="https://download.eclipse.org/releases/2026-03"/>

      <!-- Core RCP / e4 stack -->
      <unit id="org.eclipse.e4.rcp.feature.group" version="0.0.0"/>

      <!-- Platform (jobs, runtime, resources, etc.) -->
      <unit id="org.eclipse.platform.feature.group" version="0.0.0"/>
      
    </location>

  </locations>
</target>